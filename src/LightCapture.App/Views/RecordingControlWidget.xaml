<Window x:Class="LightCapture.App.Views.RecordingControlWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Storyboard x:Key="RecDotPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0"
                             Duration="0:0:0.6"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#0F172A"
            BorderBrush="#334155"
            BorderThickness="1.5"
            CornerRadius="22"
            Padding="10,6"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 🔴 Punto REC parpadeante -->
            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="#EF4444" Margin="2,0,8,0" VerticalAlignment="Center"/>

            <!-- Badge GIF (si aplica) -->
            <Border x:Name="BadgeGif" Background="#0284C7" CornerRadius="8" Padding="6,2" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="GIF 15s" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
            </Border>

            <!-- ⏱️ Contador de Tiempo -->
            <TextBlock x:Name="TxtTimer"
                       Text="00:00"
                       FontFamily="Consolas, Segoe UI"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <!-- Separador -->
            <Rectangle Width="1" Height="18" Fill="#334155" Margin="0,0,8,0" VerticalAlignment="Center"/>

            <!-- 🔊 Botón Alternar Audio Sistema -->
            <Button x:Name="BtnAudioToggle"
                    Width="32" Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,4,0"
                    ToolTip="Alternar audio del sistema"
                    Click="BtnAudioToggle_Click">
                <TextBlock x:Name="TxtAudioIcon" Text="🔊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- 🎙️ Botón Alternar Micrófono / Narración -->
            <Button x:Name="BtnMicToggle"
                    Width="32" Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0"
                    ToolTip="Alternar micrófono / voz"
                    Click="BtnMicToggle_Click">
                <TextBlock x:Name="TxtMicIcon" Text="🎙️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- ⏹️ Botón Finalizar Grabación -->
            <Button x:Name="BtnStop"
                    Background="#EF4444"
                    BorderThickness="0"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Padding="10,5"
                    Cursor="Hand"
                    Margin="0,0,6,0"
                    Click="BtnStop_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏹" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Detener" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ❌ Botón Cancelar -->
            <Button x:Name="BtnCancel"
                    Width="28" Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#94A3B8"
                    Cursor="Hand"
                    ToolTip="Cancelar grabación (Descartar)"
                    Click="BtnCancel_Click">
                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
