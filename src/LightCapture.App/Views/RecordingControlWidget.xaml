<Window x:Class="LightCapture.App.Views.RecordingControlWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Storyboard x:Key="RecDotPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0"
                             Duration="0:0:0.6"/>
        </Storyboard>

        <!-- Estilo botones de selección de formato (MP4 / GIF) -->
        <Style x:Key="FormatToggleBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo botón de acción dinámico (Iniciar / Detener) -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1.5"
            CornerRadius="22"
            Padding="12,6"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 🔴 Punto REC (Gris en espera, Rojo parpadeante grabando) -->
            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="#64748B" Margin="2,0,10,0" VerticalAlignment="Center"/>

            <!-- Selector de Formato: MP4 vs GIF -->
            <Border Background="{DynamicResource ActionBtnBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Opción MP4 -->
                    <Button x:Name="BtnFormatMp4" Style="{StaticResource FormatToggleBtnStyle}" Click="BtnFormatMp4_Click" ToolTip="Grabar video MP4 con soporte de audio y micrófono">
                        <TextBlock x:Name="TxtFormatMp4" Text="🎬 MP4" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Button>

                    <!-- Opción GIF (máx 15s) -->
                    <Button x:Name="BtnFormatGif" Style="{StaticResource FormatToggleBtnStyle}" Click="BtnFormatGif_Click" ToolTip="Grabar GIF Animado en bucle sin sonido (máximo 15 segundos)">
                        <TextBlock x:Name="TxtFormatGif" Text="🎞️ GIF (≤15s)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ⏱️ Contador de Tiempo -->
            <TextBlock x:Name="TxtTimer"
                       Text="00:00"
                       FontFamily="Consolas, Segoe UI"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryText}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <!-- Separador Audio -->
            <Rectangle x:Name="SepAudio" Width="1" Height="18" Fill="{DynamicResource ToolbarSeparator}" Margin="0,0,8,0" VerticalAlignment="Center"/>

            <!-- 🔊 Botón Audio Sistema (solo MP4) -->
            <Button x:Name="BtnAudioToggle"
                    Width="30" Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,4,0"
                    ToolTip="Alternar audio del sistema"
                    Click="BtnAudioToggle_Click">
                <TextBlock x:Name="TxtAudioIcon" Text="🔊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- 🎙️ Botón Micrófono (solo MP4) -->
            <Button x:Name="BtnMicToggle"
                    Width="30" Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,6,0"
                    ToolTip="Alternar micrófono / voz"
                    Click="BtnMicToggle_Click">
                <TextBlock x:Name="TxtMicIcon" Text="🎙️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- ⚡ / 🎬 Selector de Tasa de Cuadros (60 FPS vs 30 FPS) -->
            <Border x:Name="BorderFpsToggle"
                    Background="{DynamicResource ActionBtnBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <Button x:Name="BtnFpsToggle"
                        Height="26"
                        Padding="8,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Tasa de fotogramas (60 FPS ultra fluido o 30 FPS ligero). Clic para alternar."
                        Click="BtnFpsToggle_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFpsIcon" Text="⚡" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtFps" Text="60 FPS" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Separador Acción -->
            <Rectangle Width="1" Height="18" Fill="{DynamicResource ToolbarSeparator}" Margin="0,0,10,0" VerticalAlignment="Center"/>

            <!-- ▶ / ⏹ Botón Dinámico de Grabación (Iniciar / Detener) -->
            <Button x:Name="BtnAction"
                    Style="{StaticResource ActionBtnStyle}"
                    Background="#10B981"
                    Margin="0,0,6,0"
                    Click="BtnAction_Click"
                    ToolTip="Iniciar grabación de pantalla">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtActionIcon" Text="▶" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtActionText" Text="Iniciar" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ❌ Botón Cancelar (Descartar y salir) -->
            <Button x:Name="BtnCancel"
                    Width="28" Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource SecondaryText}"
                    Cursor="Hand"
                    ToolTip="Cancelar (Descartar)"
                    Click="BtnCancel_Click">
                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
