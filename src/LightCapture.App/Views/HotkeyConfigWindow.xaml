<Window x:Class="LightCapture.App.Views.HotkeyConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Capture Hotkey - Master Capture"
        Width="520" Height="440"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⌨️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Screen Capture Hotkey" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Customize the global key or shortcut to start screen capture anytime."
                       FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="32,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1.5" CornerRadius="12" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CURRENTLY ASSIGNED HOTKEY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                <!-- Interactive Key Detector Box -->
                <Border x:Name="KeyCaptureBox"
                        Background="#111827" BorderBrush="#3B82F6" BorderThickness="2"
                        CornerRadius="10" Padding="16,14" Margin="0,0,0,12"
                        Focusable="True" Cursor="Hand"
                        PreviewKeyDown="KeyCaptureBox_PreviewKeyDown"
                        GotFocus="KeyCaptureBox_GotFocus"
                        LostFocus="KeyCaptureBox_LostFocus"
                        MouseDown="KeyCaptureBox_MouseDown">
                    <StackPanel HorizontalAlignment="Center">
                        <Border x:Name="KeyBadge" Background="#1D4ED8" CornerRadius="8" Padding="20,8" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentKeyBadge" Text="F9" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtKeyInstruction" Text="👉 Click here and press any key on your keyboard" FontSize="11.5" Foreground="#93C5FD" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Popular presets -->
                <TextBlock Text="Or choose a popular preset shortcut:" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,6" HorizontalAlignment="Center"/>
                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="F9 (Default)" Margin="3" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Cursor="Hand" Click="PresetF9_Click"/>
                    <Button Content="Print Screen" Margin="3" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Cursor="Hand" Click="PresetPrintScreen_Click"/>
                    <Button Content="F10" Margin="3" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Cursor="Hand" Click="PresetF10_Click"/>
                    <Button Content="F8" Margin="3" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Cursor="Hand" Click="PresetF8_Click"/>
                    <Button Content="F7" Margin="3" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Cursor="Hand" Click="PresetF7_Click"/>
                    <Button Content="Ctrl + Shift + X" Margin="3" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Cursor="Hand" Click="PresetCtrlShiftX_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Reset to F9" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Padding="8,6" Click="BtnReset_Click"/>
            
            <Button Grid.Column="2" Content="Cancel" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Padding="16,7" Margin="0,0,8,0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Grid.Column="3" Content="Save and Apply" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Padding="18,7" Cursor="Hand" Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</Window>
