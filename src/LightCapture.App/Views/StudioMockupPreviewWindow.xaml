<Window x:Class="LightCapture.App.Views.StudioMockupPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Captura Embellecida - Modo Studio"
        Width="780" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="#121215" Foreground="#ECECEF"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎨 Modo Studio" FontSize="18" FontWeight="Bold" Foreground="#FFF" Margin="0,0,10,0"/>
                <Border Background="#14532D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="12" Padding="10,3">
                    <TextBlock Text="✅ Copiado automáticamente al portapapeles" FontSize="11" Foreground="#86EFAC" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Área de Previsualización -->
        <Border Grid.Row="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16">
            <Image x:Name="MockupImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Barra de Botones Inferior -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Listo para pegar en WhatsApp, Slack, correo o presentaciones con fondo estético."
                       Foreground="#71717A" FontSize="11" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📋 Copiar de nuevo" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Padding="14,7" Margin="0,0,8,0" Cursor="Hand" Click="BtnCopy_Click"/>
                <Button Content="💾 Guardar como PNG..." Background="#059669" Foreground="#FFF" BorderBrush="#10B981" Padding="14,7" Margin="0,0,8,0" Cursor="Hand" Click="BtnSave_Click"/>
                <Button Content="Cerrar" Background="#18181B" Foreground="#A1A1AA" BorderBrush="#27272A" Padding="14,7" Cursor="Hand" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
