<Window x:Class="LightCapture.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Capturas - Light Capture Studio"
        Width="880" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🕒 Historial de Capturas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,8,0"/>
                <Border x:Name="CountBadge" Background="#2E1065" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalCount" Text="0 capturas" FontSize="11" Foreground="#C4B5FD" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Search box -->
            <Border Grid.Column="1" Margin="20,0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                <Grid>
                    <TextBlock x:Name="SearchPlaceholder" Text="🔍 Buscar por palabras detectadas en pantalla..." Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" FontSize="13" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkIncognito" Content="Modo Incógnito" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Pausa el guardado de capturas en disco para privacidad" Checked="ChkIncognito_Checked" Unchecked="ChkIncognito_Unchecked"/>
                <Button Content="📁 Abrir carpeta" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#3B82F6" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" ToolTip="Abrir la carpeta Documentos\Light Capture en el Explorador de Windows" Click="BtnOpenFolder_Click"/>
                <Button Content="Vaciar todo" Background="#3F1D1D" Foreground="#FCA5A5" BorderBrush="#7F1D1D" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnClearAll_Click"/>
                <Button Content="Cerrar" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Padding="14,6" Cursor="Hand" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Gallery Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryItemsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="264" Margin="6" Background="#1C1C22" BorderBrush="#2E2E38" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="315" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Thumbnail -->
                                <Border Height="140" Background="#0D0D11" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,8">
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Timestamp -->
                                <TextBlock Text="{Binding TimestampText}" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>

                                <!-- OCR Snippet -->
                                <TextBlock Text="{Binding OcrTextSnippet}" FontSize="12" Foreground="#E4E4E7" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                                <!-- Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="Copiar Img" FontSize="10" Padding="0,4" Margin="0,0,2,0" Background="#2E1065" Foreground="#E9D5FF" BorderBrush="#6B21A8" Cursor="Hand" Tag="{Binding}" Click="BtnCopyImage_Click"/>
                                    <Button Grid.Column="1" Content="Copiar Txt" FontSize="10" Padding="0,4" Margin="2,0,2,0" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#1E40AF" Cursor="Hand" Tag="{Binding}" Click="BtnCopyText_Click"/>
                                    <Button Grid.Column="2" Content="❌" FontSize="10" Padding="6,4" Margin="2,0,0,0" Background="#450A0A" Foreground="#FCA5A5" BorderBrush="#991B1B" Cursor="Hand" Tag="{Binding}" Click="BtnDelete_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Privacy note footer -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="8,4" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="📁 Las capturas se guardan automáticamente en tu carpeta Documentos\Light Capture Studio. Privacidad: 100% local en tu equipo." FontSize="10.5" Foreground="#71717A" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
