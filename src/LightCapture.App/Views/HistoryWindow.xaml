<Window x:Class="LightCapture.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture History - Light Capture Studio"
        Width="880" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🕒 Capture History" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,8,0"/>
                <Border x:Name="CountBadge" Background="#2E1065" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalCount" Text="0 captures" FontSize="11" Foreground="#C4B5FD" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Search box -->
            <Border Grid.Column="1" Margin="20,0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                <Grid>
                    <TextBlock x:Name="SearchPlaceholder" Text="🔍 Search words detected on screen..." Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" FontSize="13" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkIncognito" Content="Incognito Mode" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Pauses saving captures to disk for privacy" Checked="ChkIncognito_Checked" Unchecked="ChkIncognito_Unchecked"/>
                <CheckBox x:Name="ChkSelectAll" Content="Select All" Foreground="#E4E4E7" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Select or deselect all visible captures" Checked="ChkSelectAll_Checked" Unchecked="ChkSelectAll_Unchecked"/>
                <Button x:Name="BtnDeleteSelected" Content="🗑️ Delete Selected" Background="#450A0A" Foreground="#FCA5A5" BorderBrush="#991B1B" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" ToolTip="Delete selected captures from disk and history" Click="BtnDeleteSelected_Click"/>
                <Button Content="📁 Open Folder" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#3B82F6" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" ToolTip="Open Documents\Light Capture folder in Windows Explorer" Click="BtnOpenFolder_Click"/>
                <Button Content="Clear All" Background="#3F1D1D" Foreground="#FCA5A5" BorderBrush="#7F1D1D" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnClearAll_Click"/>
                <Button Content="Close" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Padding="14,6" Cursor="Hand" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Gallery Grid & Empty Placeholder -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryItemsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="264" Margin="6" Background="#1C1C22" BorderBrush="#2E2E38" BorderThickness="1" CornerRadius="8" Padding="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="315" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Thumbnail with Selection Checkbox overlay -->
                                    <Grid Margin="0,0,0,8">
                                        <Border Height="140" Background="#0D0D11" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Cursor="Hand" ToolTip="Select for batch delete" Checked="ItemCheckBox_Changed" Unchecked="ItemCheckBox_Changed">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </Grid>

                                    <!-- Timestamp -->
                                    <TextBlock Text="{Binding TimestampText}" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>

                                    <!-- OCR Snippet -->
                                    <TextBlock Text="{Binding OcrTextSnippet}" FontSize="12" Foreground="#E4E4E7" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                                    <!-- Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="Copy Img" FontSize="10" Padding="0,4" Margin="0,0,2,0" Background="#2E1065" Foreground="#E9D5FF" BorderBrush="#6B21A8" Cursor="Hand" Tag="{Binding}" Click="BtnCopyImage_Click"/>
                                        <Button Grid.Column="1" Content="Copy Txt" FontSize="10" Padding="0,4" Margin="2,0,2,0" Background="#1E293B" Foreground="#93C5FD" BorderBrush="#1E40AF" Cursor="Hand" Tag="{Binding}" Click="BtnCopyText_Click"/>
                                        <Button Grid.Column="2" Content="❌" FontSize="10" Padding="6,4" Margin="2,0,0,0" Background="#450A0A" Foreground="#FCA5A5" BorderBrush="#991B1B" Cursor="Hand" Tag="{Binding}" Click="BtnDelete_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Elegant placeholder when no captures exist -->
            <Border x:Name="EmptyHistoryPlaceholder" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#16161D" BorderBrush="#27272A" BorderThickness="1.5" CornerRadius="12" Padding="32,24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📸" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="No captures in history yet" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Your captures are indexed and saved here automatically when copying or saving." FontSize="12" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="📁 Open Documents\Light Capture folder" Padding="14,8" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Click="BtnOpenFolder_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Privacy note footer -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="8,4" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="📁 Captures are automatically saved in your Documents\Light Capture folder. Privacy: 100% local on your machine." FontSize="10.5" Foreground="#71717A" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
