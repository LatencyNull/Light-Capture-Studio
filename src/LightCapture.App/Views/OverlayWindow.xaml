<Window x:Class="LightCapture.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LightCapture.App.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">
    
    <Grid x:Name="RootGrid">
        <!-- 1. Imagen del escritorio congelado (Alineación 1:1 exacta sin salto ni zoom) -->
        <Image x:Name="FrozenScreenImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- 2. Capa de oscurecimiento (Todo menos la selección) -->
        <Path x:Name="DimmingPath" Fill="#80000000"/>

        <!-- 3. Marco de selección con borde punteado (Marching Ants) y tiradores -->
        <Canvas x:Name="SelectionLayer">
            <!-- Marco de vista previa para ajuste magnético automático a ventanas -->
            <Border x:Name="WindowSnapBorder" 
                    BorderBrush="#2563EB" BorderThickness="2.5" 
                    Background="#183B82F6" CornerRadius="4" 
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#3B82F6" Opacity="0.6"/>
                </Border.Effect>
            </Border>

            <!-- Borde exterior punteado de selección -->
            <Rectangle x:Name="SelectionRect" Stroke="#FFF" StrokeThickness="1" StrokeDashArray="4 4" SnapsToDevicePixels="True"/>
            <Rectangle x:Name="SelectionRectBacking" Stroke="#000" StrokeThickness="1" StrokeDashArray="4 4" StrokeDashOffset="4" SnapsToDevicePixels="True"/>

            <!-- Tooltip de dimensiones estilo Lightshot (ej: 654x268) -->
            <Border x:Name="DimensionTag" Background="#2B2B2B" BorderBrush="#444" BorderThickness="1" CornerRadius="2" Padding="4,1" Visibility="Collapsed">
                <TextBlock x:Name="DimensionText" Text="0x0" FontSize="11" Foreground="#FFF" FontFamily="Segoe UI" FontWeight="SemiBold"/>
            </Border>

            <!-- ⭐ NUEVO: Banner flotante de Código QR Detectado -->
            <Border x:Name="QrCodeBanner" Visibility="Collapsed" Background="#18181B" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="4" Padding="8,4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="315" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔗 QR:" FontWeight="Bold" Foreground="#10B981" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="QrTextPreview" Text="https://..." MaxWidth="240" TextTrimming="CharacterEllipsis" Foreground="#FFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Copiar" FontSize="10" Padding="6,1" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Cursor="Hand" Click="BtnQrCopy_Click" Margin="0,0,4,0"/>
                    <Button Content="Abrir" FontSize="10" Padding="6,1" Background="#059669" Foreground="#FFF" BorderBrush="#10B981" Cursor="Hand" Click="BtnQrOpen_Click"/>
                </StackPanel>
            </Border>

            <!-- 8 Tiradores de redimensionado estilo profesional -->
            <Canvas x:Name="HandlesLayer" Visibility="Collapsed" Panel.ZIndex="60">
                <Rectangle x:Name="HandleNW" Width="8" Height="8" Fill="#FFFFFF" Stroke="#0284C7" StrokeThickness="1.5" Cursor="SizeNWSE"/>
                <Rectangle x:Name="HandleN"  Width="8" Height="8" Fill="#FFFFFF" Stroke="#0284C7" StrokeThickness="1.5" Cursor="SizeNS"/>
                <Rectangle x:Name="HandleNE" Width="8" Height="8" Fill="#FFFFFF" Stroke="#0284C7" StrokeThickness="1.5" Cursor="SizeNESW"/>
                <Rectangle x:Name="HandleW"  Width="8" Height="8" Fill="#FFFFFF" Stroke="#0284C7" StrokeThickness="1.5" Cursor="SizeWE"/>
                <Rectangle x:Name="HandleE"  Width="8" Height="8" Fill="#FFFFFF" Stroke="#0284C7" StrokeThickness="1.5" Cursor="SizeWE"/>
                <Rectangle x:Name="HandleSW" Width="8" Height="8" Fill="#FFFFFF" Stroke="#0284C7" StrokeThickness="1.5" Cursor="SizeNESW"/>
                <Rectangle x:Name="HandleS"  Width="8" Height="8" Fill="#FFFFFF" Stroke="#0284C7" StrokeThickness="1.5" Cursor="SizeNS"/>
                <Rectangle x:Name="HandleSE" Width="8" Height="8" Fill="#FFFFFF" Stroke="#0284C7" StrokeThickness="1.5" Cursor="SizeNWSE"/>
            </Canvas>

            <!-- Canvas de dibujo interactivo y capas Lens -->
            <controls:DrawingCanvas x:Name="MainDrawingCanvas"/>

            <!-- Cuadro de texto interactivo estilo Photoshop: directo sobre la imagen, sin marcos pesados -->
            <Border x:Name="FloatingTextContainer"
                    Visibility="Collapsed"
                    Background="#10000000"
                    BorderBrush="#38BDF8"
                    BorderThickness="1"
                    CornerRadius="2"
                    MinWidth="100"
                    MinHeight="32"
                    SnapsToDevicePixels="True"
                    Panel.ZIndex="85">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <!-- TextBox directo, transparente y de máxima legibilidad con sombra de texto -->
                    <TextBox x:Name="FloatingInputBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#EF4444"
                             FontFamily="Segoe UI Semibold"
                             FontSize="20"
                             Padding="3,1,10,10"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             CaretBrush="#FFFFFF"
                             LostFocus="FloatingInputBox_LostFocus"
                             KeyDown="FloatingInputBox_KeyDown"
                             PreviewMouseWheel="FloatingInputBox_PreviewMouseWheel">
                        <TextBox.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#000000" Opacity="0.85"/>
                        </TextBox.Effect>
                    </TextBox>

                    <!-- Tirador sutil de esquina estilo transformación libre de Photoshop -->
                    <Rectangle x:Name="FloatingTextResizeGrip"
                               Width="8" Height="8"
                               Fill="#FFFFFF"
                               Stroke="#0284C7"
                               StrokeThickness="1.5"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Cursor="SizeNWSE"
                               Margin="0,0,-4,-4"
                               ToolTip="Estirar para agrandar/achicar tamaño"
                               PreviewMouseLeftButtonDown="FloatingTextResizeGrip_MouseDown"
                               PreviewMouseMove="FloatingTextResizeGrip_MouseMove"
                               PreviewMouseLeftButtonUp="FloatingTextResizeGrip_MouseUp"/>
                </Grid>
            </Border>

            <!-- Barras de herramientas de Lightshot -->
            <controls:LightshotToolbar x:Name="MainToolbar" Visibility="Collapsed" Panel.ZIndex="100"/>
        </Canvas>

        <!-- 4. Notificación flotante (Toast) -->
        <Border x:Name="ToastNotification" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Background="#222" BorderBrush="#8B5CF6" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#A855F7" Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText" Text="Mensaje" Foreground="#FFF" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
