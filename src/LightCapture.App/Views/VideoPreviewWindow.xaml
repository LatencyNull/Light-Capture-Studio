<Window x:Class="LightCapture.App.Views.VideoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Previsualización del Clip - Light Capture"
        Width="720" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Estilo botones de acción rápida -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Background" Value="{DynamicResource ActionBtnBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ActionBtnHover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource ToolbarBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolbarPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario de guardado/copiado -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu estilo Samsung One UI Adaptativo -->
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.45"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Margin="2,1" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}"/>
    </Window.Resources>

    <!-- Contenedor exterior estilo Samsung One UI Adaptativo -->
    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1.5"
            CornerRadius="18"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Cabecera -->
                <RowDefinition Height="*"/>    <!-- Reproductor de video -->
                <RowDefinition Height="Auto"/> <!-- Barra de Reproducción y Recorte tipo Fotos -->
                <RowDefinition Height="Auto"/> <!-- Barra de acciones -->
            </Grid.RowDefinitions>

            <!-- 1. Cabecera -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderIcon" Text="🎥" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHeaderTitle" Text="Previsualización del Clip" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <Border Background="#0284C7" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="✂️ Recorte de Video / GIF" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVideoInfo" Text="00:00 • 0.0 MB" FontSize="11" FontWeight="Medium" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <Button Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryText}" Cursor="Hand" Click="BtnClose_Click" ToolTip="Cerrar">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. Área de Reproducción de Video -->
            <Border Grid.Row="1" Background="#000000" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,12" MouseLeftButtonUp="VideoPlayer_MouseClick">
                <Grid>
                    <MediaElement x:Name="MediaVideoPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Close"
                                  Stretch="Uniform"
                                  MediaEnded="MediaVideoPlayer_MediaEnded"/>

                    <!-- Indicador de Pausa en el centro -->
                    <Border x:Name="PauseIndicator" Width="54" Height="54" CornerRadius="27" Background="#80000000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="▶" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2.5 Barra de Reproducción y Recorte tipo 'Fotos de Windows' -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Guía y badge de recorte -->
                        <RowDefinition Height="Auto"/> <!-- Controles y Timeline con pines -->
                    </Grid.RowDefinitions>

                    <!-- Fila 0: Guía visual de la herramienta de recorte -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0284C7" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="✂️ HERRAMIENTA DE RECORTE" FontSize="10" FontWeight="Black" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="Arrastra los tiradores [ ✂ y ✂ ] para recortar el clip" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Badge info de recorte y botón de restablecer -->
                        <Border x:Name="BadgeTrimInfo" HorizontalAlignment="Right" Background="{DynamicResource ActionBtnBackground}" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTrimDuration" Text="✂️ 00:00.0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                <Button x:Name="BtnResetTrim" Background="Transparent" BorderThickness="0" Foreground="#F59E0B" Cursor="Hand" Padding="8,0,0,0" Click="BtnResetTrim_Click" ToolTip="Restablecer recorte a duración completa" Visibility="Collapsed">
                                    <TextBlock Text="↺ Restablecer" FontSize="11" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 1: Reproductor, Scrubber y Timeline interactiva -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Play/Pause -->
                            <ColumnDefinition Width="Auto"/> <!-- Tiempo actual -->
                            <ColumnDefinition Width="*"/>    <!-- Timeline con tiradores de recorte -->
                        </Grid.ColumnDefinitions>

                        <!-- Botón Play/Pause -->
                        <Button x:Name="BtnPlayPause" Grid.Column="0" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnPlayPause_Click" ToolTip="Reproducir / Pausar">
                            <TextBlock x:Name="TxtPlayPauseIcon" Text="⏸" FontSize="14" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Tiempo de reproducción actual -->
                        <TextBlock x:Name="TxtPlaybackPosition" Grid.Column="1" Text="00:00 / 00:00" FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="8,0,12,0"/>

                        <!-- Línea de tiempo interactiva con Recorte tipo Fotos de Windows -->
                        <Grid x:Name="TimelineContainer" Grid.Column="2" Height="32" VerticalAlignment="Center" Margin="4,0" SizeChanged="TimelineContainer_SizeChanged">
                            <!-- Pista inactiva completa (Fondo oscuro) -->
                            <Border Height="8" Background="{DynamicResource ToolbarSeparator}" CornerRadius="4" VerticalAlignment="Center"/>

                            <!-- Pista activa recortada (Rango entre Inicio y Fin) -->
                            <Border x:Name="ActiveRangeTrack" Height="8" Background="#38BDF8" CornerRadius="4" HorizontalAlignment="Left" Width="100" Margin="0,0,0,0" VerticalAlignment="Center"/>

                            <!-- Canvas para los cursores y pines -->
                            <Canvas x:Name="TimelineCanvas" ClipToBounds="False" MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown">
                                <!-- Pin de Inicio (Izquierdo estilo corchete de recorte) -->
                                <Border x:Name="PinStart" Width="20" Height="28" Background="#0284C7" BorderBrush="#FFFFFF" BorderThickness="1.5" CornerRadius="6,0,0,6" Cursor="SizeWE" Canvas.Left="0" Canvas.Top="2" ToolTip="Tirador de Inicio del Recorte [✂]" MouseLeftButtonDown="PinStart_MouseLeftButtonDown" MouseLeftButtonUp="Pin_MouseLeftButtonUp" MouseMove="PinStart_MouseMove">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="[ ✂" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,0,0,0"/>
                                </Border>

                                <!-- Pin de Fin (Derecho estilo corchete de recorte) -->
                                <Border x:Name="PinEnd" Width="20" Height="28" Background="#0284C7" BorderBrush="#FFFFFF" BorderThickness="1.5" CornerRadius="0,6,6,0" Cursor="SizeWE" Canvas.Left="100" Canvas.Top="2" ToolTip="Tirador de Fin del Recorte [✂]" MouseLeftButtonDown="PinEnd_MouseLeftButtonDown" MouseLeftButtonUp="Pin_MouseLeftButtonUp" MouseMove="PinEnd_MouseMove">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="✂ ]" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                </Border>

                                <!-- Aguja de reproducción actual (Playhead) -->
                                <Border x:Name="Playhead" Width="3" Height="24" Background="#FFFFFF" CornerRadius="1.5" Canvas.Left="0" Canvas.Top="4" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#FFFFFF" Opacity="0.9"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Barra de Acciones y Compartir -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Acciones Principales (Izquierda) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Más Redes: WhatsApp, Discord, TikTok, Instagram, Facebook, Telegram, X -->
                    <Button x:Name="BtnMoreSocial" Style="{StaticResource ActionBtnStyle}" Margin="0,0,10,0" Click="BtnMoreSocial_Click" ToolTip="Compartir en WhatsApp, Discord, TikTok, Instagram, Facebook, Telegram, X...">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 Redes ▾" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenuStyle}" Placement="Top" VerticalOffset="-6">
                                <MenuItem Header="WhatsApp (App de Windows)" Click="ShareWhatsAppApp_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/whatsapp.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="WhatsApp Web" Click="ShareWhatsAppWeb_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/whatsapp.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{DynamicResource ToolbarSeparator}" Margin="4,2"/>
                                <MenuItem Header="Discord" Click="BtnShareDiscord_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/discord.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="TikTok" Click="ShareTikTok_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/tiktok.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Instagram" Click="ShareInstagram_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/instagram.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Facebook" Click="ShareFacebook_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/facebook.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{DynamicResource ToolbarSeparator}" Margin="4,2"/>
                                <MenuItem Header="Telegram" Click="ShareTelegram_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/telegram.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="X (Twitter)" Click="ShareTwitter_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/x.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Copiar Archivo Clip -->
                    <Button Style="{StaticResource PrimaryActionBtnStyle}" Margin="0,0,10,0" Click="BtnCopyClip_Click" ToolTip="Copiar video o GIF al portapapeles (Ctrl+V en cualquier app)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/copy.png" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TxtCopyClipLabel" Text="Copiar Clip" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Guardar -->
                    <Button Style="{StaticResource ActionBtnStyle}" Click="BtnSaveClip_Click" ToolTip="Guardar archivo en disco (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/save.png" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TxtSaveClipLabel" Text="Guardar..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Descartar / Eliminar (Derecha) -->
                <Button Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Padding="10,6" Click="BtnDiscard_Click" ToolTip="Descartar este clip">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗑️" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Descartar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
