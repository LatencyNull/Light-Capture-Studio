<Window x:Class="LightCapture.App.Views.VideoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LightCapture.App.Controls"
        Title="Clip Preview - Light Capture"
        Width="720" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Estilo botones de acción rápida -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Background" Value="{DynamicResource ActionBtnBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ActionBtnHover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource ToolbarBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolbarPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario de guardado/copiado -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu estilo Samsung One UI Adaptativo -->
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.45"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Margin="2,1" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}"/>

        <!-- Estilos para la barra de herramientas de anotación del video -->
        <Style x:Key="AnnotationActionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolbarHover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource ToolbarBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolbarPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnnotationToggleBtnStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolbarHover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource ToolbarBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolbarPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor exterior estilo Samsung One UI Adaptativo -->
    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1.5"
            CornerRadius="18"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Cabecera -->
                <RowDefinition Height="*"/>    <!-- Reproductor de video -->
                <RowDefinition Height="Auto"/> <!-- Barra de Reproducción y Recorte tipo Fotos -->
                <RowDefinition Height="Auto"/> <!-- Pistas de Objetos estilo CapCut -->
                <RowDefinition Height="Auto"/> <!-- Barra de acciones -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderIcon" Text="🎥" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHeaderTitle" Text="Clip Preview" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVideoInfo" Text="00:00 • 0.0 MB" FontSize="11" FontWeight="Medium" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <Button Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryText}" Cursor="Hand" Click="BtnClose_Click" ToolTip="Close">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. Área de Reproducción y Anotaciones de Video -->
            <Border Grid.Row="1" Background="#000000" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,12">
                <Grid x:Name="VideoContainer">
                    <!-- Reproductor de video centrado con ajuste uniforme -->
                    <MediaElement x:Name="MediaVideoPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Close"
                                  ScrubbingEnabled="True"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsHitTestVisible="False"
                                  MediaOpened="MediaVideoPlayer_MediaOpened"
                                  MediaEnded="MediaVideoPlayer_MediaEnded"/>

                    <!-- Capa vectorial de anotaciones acelerada por GPU sobre todo el marco -->
                    <controls:DrawingCanvas x:Name="VideoDrawingCanvas"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            ClipToBounds="True"
                                            PreviewMouseLeftButtonDown="VideoDrawingCanvas_MouseDown"
                                            PreviewMouseMove="VideoDrawingCanvas_MouseMove"
                                            PreviewMouseLeftButtonUp="VideoDrawingCanvas_MouseUp"/>

                    <!-- Cuadro de texto interactivo estilo Photoshop: directo sobre el video, sin marcos pesados -->
                    <Border x:Name="VideoFloatingTextContainer"
                            Visibility="Collapsed"
                            Background="#12000000"
                            BorderBrush="#38BDF8"
                            BorderThickness="1"
                            CornerRadius="2"
                            MinWidth="100"
                            MinHeight="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            SnapsToDevicePixels="True"
                            Panel.ZIndex="85">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Mini barra flotante de confirmación estilo Photoshop (Palomita verde ✓ y Cancelar ✕) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-24,0,0" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                                    CornerRadius="10" Padding="3,2" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.6"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Drag handle ✥ -->
                                    <Border x:Name="BtnDragVideoText" Width="18" Height="18" CornerRadius="9"
                                            Background="#334155" Cursor="SizeAll" Margin="1,0,3,0"
                                            ToolTip="Drag here to move text box"
                                            PreviewMouseLeftButtonDown="BtnDragVideoText_MouseDown"
                                            PreviewMouseMove="BtnDragVideoText_MouseMove"
                                            PreviewMouseLeftButtonUp="BtnDragVideoText_MouseUp">
                                        <TextBlock Text="✥" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                    <!-- Green checkmark confirm ✓ -->
                                    <Border x:Name="BtnConfirmVideoText" Width="18" Height="18" CornerRadius="9"
                                            Background="#10B981" Cursor="Hand" Margin="0,0,3,0"
                                            ToolTip="Confirm and add text to video (Enter)"
                                            PreviewMouseLeftButtonDown="BtnConfirmVideoText_MouseDown">
                                        <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                    <!-- Cancel button ✕ -->
                                    <Border x:Name="BtnCancelVideoText" Width="18" Height="18" CornerRadius="9"
                                            Background="#EF4444" Cursor="Hand" Margin="0,0,1,0"
                                            ToolTip="Cancel and discard (Esc)"
                                            PreviewMouseLeftButtonDown="BtnCancelVideoText_MouseDown">
                                        <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Direct transparent TextBox with drop shadow -->
                            <TextBox x:Name="VideoFloatingInput"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#EF4444"
                                     FontFamily="Segoe UI Semibold"
                                     FontSize="20"
                                     Padding="3,1,10,10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     CaretBrush="#FFFFFF"
                                     LostFocus="VideoFloatingInput_LostFocus"
                                     PreviewKeyDown="VideoFloatingInput_PreviewKeyDown"
                                     PreviewMouseWheel="VideoFloatingInput_PreviewMouseWheel">
                                <TextBox.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#000000" Opacity="0.85"/>
                                </TextBox.Effect>
                            </TextBox>

                            <!-- Subtle corner stretch grip -->
                            <Rectangle x:Name="VideoFloatingTextResizeGrip"
                                       Width="8" Height="8"
                                       Fill="#FFFFFF"
                                       Stroke="#0284C7"
                                       StrokeThickness="1.5"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Cursor="SizeNWSE"
                                       Margin="0,0,-4,-4"
                                       ToolTip="Drag to scale font size"
                                       PreviewMouseLeftButtonDown="VideoFloatingTextResizeGrip_MouseDown"
                                       PreviewMouseMove="VideoFloatingTextResizeGrip_MouseMove"
                                       PreviewMouseLeftButtonUp="VideoFloatingTextResizeGrip_MouseUp"/>
                        </Grid>
                    </Border>

                    <!-- Indicador de Pausa en el centro -->
                    <Border x:Name="PauseIndicator" Width="54" Height="54" CornerRadius="27" Background="#80000000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="▶" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </Border>

                    <!-- Barra flotante de herramientas de anotación estilo cápsula Samsung One UI -->
                    <Border x:Name="AnnotationToolbar"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,10,0,0"
                            Background="{DynamicResource ToolbarBackground}"
                            BorderBrush="{DynamicResource ToolbarBorder}"
                            BorderThickness="1.2"
                            CornerRadius="12"
                            Padding="4,3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <!-- 1. Pointer / Playback Mode -->
                            <RadioButton x:Name="BtnToolPointer" GroupName="VideoAnnotationTools" Style="{StaticResource AnnotationToggleBtnStyle}" IsChecked="True" ToolTip="Pointer / Playback Mode&#x0a;Click on video to play or pause" Click="BtnToolPointer_Click">
                                <TextBlock Text="👆" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton>

                            <!-- 2. Arrow -->
                            <RadioButton x:Name="BtnToolArrow" GroupName="VideoAnnotationTools" Style="{StaticResource AnnotationToggleBtnStyle}" ToolTip="Pointer Arrow [↗️]" Click="BtnToolArrow_Click">
                                <Image Source="/Assets/Icons/arrow.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </RadioButton>

                            <!-- 3. Text -->
                            <RadioButton x:Name="BtnToolText" GroupName="VideoAnnotationTools" Style="{StaticResource AnnotationToggleBtnStyle}" ToolTip="Add Text [🔤]&#x0a;Click on video to type" Click="BtnToolText_Click">
                                <Image Source="/Assets/Icons/text.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </RadioButton>

                            <!-- 4. Freehand Pen -->
                            <RadioButton x:Name="BtnToolPen" GroupName="VideoAnnotationTools" Style="{StaticResource AnnotationToggleBtnStyle}" ToolTip="Freehand Pen [✏️]" Click="BtnToolPen_Click">
                                <Image Source="/Assets/Icons/pen.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </RadioButton>

                            <!-- 5. Rectangle -->
                            <RadioButton x:Name="BtnToolRect" GroupName="VideoAnnotationTools" Style="{StaticResource AnnotationToggleBtnStyle}" ToolTip="Rectangle Frame [🔲]" Click="BtnToolRect_Click">
                                <Image Source="/Assets/Icons/rect.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </RadioButton>

                            <!-- 6. Knox Redaction -->
                            <RadioButton x:Name="BtnToolRedact" GroupName="VideoAnnotationTools" Style="{StaticResource AnnotationToggleBtnStyle}" ToolTip="Knox Redaction [🔒]&#x0a;Solid opaque block to conceal private info" Click="BtnToolRedact_Click">
                                <Image Source="/Assets/Icons/lock.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </RadioButton>

                            <!-- Separator -->
                            <Rectangle Width="1" Fill="{DynamicResource ToolbarSeparator}" Margin="4,2"/>

                            <!-- 7. Color -->
                            <Button x:Name="BtnToolColor" Style="{StaticResource AnnotationActionBtnStyle}" ToolTip="Annotation Color [🎨]" Click="BtnToolColor_Click">
                                <Grid Width="20" Height="20">
                                    <Image Source="/Assets/Icons/palette.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="VideoColorIndicator" Width="6" Height="6" CornerRadius="3" Background="#EF4444" BorderBrush="#FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                                </Grid>
                            </Button>

                            <!-- 8. Undo -->
                            <Button x:Name="BtnToolUndo" Style="{StaticResource AnnotationActionBtnStyle}" ToolTip="Undo Stroke [↩️ Ctrl+Z]" Click="BtnToolUndo_Click">
                                <Image Source="/Assets/Icons/undo.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>

                            <!-- 9. Clear -->
                            <Button x:Name="BtnToolClear" Style="{StaticResource AnnotationActionBtnStyle}" ToolTip="Clear All Annotations [🗑️]" Click="BtnToolClear_Click">
                                <TextBlock Text="🗑️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2.5 Barra de Reproducción y Recorte estilo Fotos de Windows -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>  <!-- Play/Pause y Stop -->
                        <ColumnDefinition Width="110"/> <!-- Tiempo actual (Ancho fijo inmutable) -->
                        <ColumnDefinition Width="*"/>    <!-- Timeline interactiva con tiradores estilo Fotos -->
                        <ColumnDefinition Width="80"/>  <!-- Indicador de duración y reset (Ancho fijo inmutable) -->
                    </Grid.ColumnDefinitions>

                    <!-- Botones de Control de Reproducción -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Play/Pause -->
                        <Button x:Name="BtnPlayPause" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnPlayPause_Click" ToolTip="Play / Pause (Space)">
                            <TextBlock x:Name="TxtPlayPauseIcon" Text="⏸" FontSize="13" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Stop (Rewind to start) -->
                        <Button x:Name="BtnStop" Width="30" Height="30" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnStop_Click" ToolTip="Stop and rewind to start">
                            <TextBlock Text="⏹" FontSize="13" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Tiempo de reproducción actual (Ancho fijo para evitar fluctuaciones) -->
                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                        <TextBlock x:Name="TxtPlaybackPosition" Text="00:00 / 00:00" FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Línea de tiempo interactiva con Recorte tipo Fotos de Windows -->
                    <Grid x:Name="TimelineContainer" Grid.Column="2" Height="30" VerticalAlignment="Center" Margin="4,0" SizeChanged="TimelineContainer_SizeChanged">
                        <!-- Pista inactiva completa (Fondo oscuro sutil) -->
                        <Border Height="6" Background="{DynamicResource ToolbarSeparator}" CornerRadius="3" VerticalAlignment="Center" IsHitTestVisible="False"/>

                        <!-- Pista activa recortada (Rango azul claro entre Inicio y Fin) -->
                        <Border x:Name="ActiveRangeTrack" Height="6" Background="#38BDF8" CornerRadius="3" HorizontalAlignment="Left" Width="100" Margin="0,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                        <!-- Canvas para los cursores y pines con captura interactiva de clic y arrastre -->
                        <Canvas x:Name="TimelineCanvas" Background="Transparent" Cursor="Hand" ClipToBounds="False"
                                MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                                MouseMove="TimelineCanvas_MouseMove"
                                MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp">
                            <!-- Trim Start Pin -->
                            <Border x:Name="PinStart" Width="14" Height="24" Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="6" Cursor="SizeWE" Canvas.Left="0" Canvas.Top="3" ToolTip="Trim start (drag to trim)" MouseLeftButtonDown="PinStart_MouseLeftButtonDown" MouseLeftButtonUp="Pin_MouseLeftButtonUp" MouseMove="PinStart_MouseMove">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                </Border.Effect>
                                <!-- Grab handle -->
                                <Border Width="2" Height="8" Background="#0284C7" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Trim End Pin -->
                            <Border x:Name="PinEnd" Width="14" Height="24" Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="2" CornerRadius="6" Cursor="SizeWE" Canvas.Left="100" Canvas.Top="3" ToolTip="Trim end (drag to trim)" MouseLeftButtonDown="PinEnd_MouseLeftButtonDown" MouseLeftButtonUp="Pin_MouseLeftButtonUp" MouseMove="PinEnd_MouseMove">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                </Border.Effect>
                                <!-- Grab handle -->
                                <Border Width="2" Height="8" Background="#0284C7" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Playhead needle -->
                            <Border x:Name="Playhead" Width="2" Height="22" Background="#FFFFFF" CornerRadius="1" Canvas.Left="0" Canvas.Top="4" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#FFFFFF" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Grid>

                    <!-- Duration badge and reset button -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Width="76">
                        <Border x:Name="BadgeTrimInfo" Width="48" Height="24" Background="{DynamicResource ActionBtnBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTrimDuration" Text="00:00" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="BtnResetTrim" Width="22" Height="22" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryText}" Cursor="Hand" Margin="4,0,0,0" Click="BtnResetTrim_Click" ToolTip="Reset trim to full duration" Visibility="Hidden">
                            <TextBlock Text="↺" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2.8 Object Tracks (CapCut style) -->
            <Border x:Name="ObjectTracksPanel" Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <!-- Track Header -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Timeline" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource ActionBtnBackground}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock x:Name="TxtObjectTracksCount" Text="0 objects" FontSize="10" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Drag blocks to adjust appearance and duration" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Scrollable object tracks list -->
                    <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ObjectTracksStackPanel"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 3. Actions & Sharing Bar -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Main Actions (Left) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Share button -->
                    <Button x:Name="BtnMoreSocial" Style="{StaticResource ActionBtnStyle}" Margin="0,0,10,0" Click="BtnMoreSocial_Click" ToolTip="Share to WhatsApp, Discord, TikTok, Instagram, Facebook, Telegram, X...">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"
                                  Fill="{DynamicResource PrimaryText}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Share ▾" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenuStyle}" Placement="Top" VerticalOffset="-6">
                                <MenuItem Header="WhatsApp (Windows App)" Click="ShareWhatsAppApp_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/whatsapp.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="WhatsApp Web" Click="ShareWhatsAppWeb_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/whatsapp.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{DynamicResource ToolbarSeparator}" Margin="4,2"/>
                                <MenuItem Header="Discord" Click="BtnShareDiscord_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/discord.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="TikTok" Click="ShareTikTok_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/tiktok.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Instagram" Click="ShareInstagram_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/instagram.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Facebook" Click="ShareFacebook_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/facebook.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{DynamicResource ToolbarSeparator}" Margin="4,2"/>
                                <MenuItem Header="Telegram" Click="ShareTelegram_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/telegram.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="X (Twitter)" Click="ShareTwitter_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Icons/x.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Copy Clip File -->
                    <Button Style="{StaticResource PrimaryActionBtnStyle}" Margin="0,0,10,0" Click="BtnCopyClip_Click" ToolTip="Copy video or GIF to clipboard (Ctrl+V in any app)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/copy.png" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TxtCopyClipLabel" Text="Copy Clip" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Save -->
                    <Button Style="{StaticResource ActionBtnStyle}" Click="BtnSaveClip_Click" ToolTip="Save file to disk (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/save.png" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TxtSaveClipLabel" Text="Save..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Discard (Right) -->
                <Button Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Padding="10,6" Click="BtnDiscard_Click" ToolTip="Discard this clip">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗑️" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Discard" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
