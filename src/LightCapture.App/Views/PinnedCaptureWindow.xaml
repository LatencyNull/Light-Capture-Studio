<Window x:Class="LightCapture.App.Views.PinnedCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseWheel="Window_MouseWheel"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ContextMenu x:Key="PinMenu">
            <MenuItem Header="📋 Copy image to clipboard" Click="MenuCopy_Click"/>
            <Separator/>
            <MenuItem Header="Opacity: 100%" Click="MenuOpacity100_Click"/>
            <MenuItem Header="Opacity: 80%" Click="MenuOpacity80_Click"/>
            <MenuItem Header="Opacity: 60%" Click="MenuOpacity60_Click"/>
            <MenuItem Header="Opacity: 40%" Click="MenuOpacity40_Click"/>
            <Separator/>
            <MenuItem Header="❌ Close (Esc)" Click="MenuClose_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Border Margin="12" CornerRadius="6" Background="#1E1E24" BorderBrush="#7C3AED" BorderThickness="1.5"
            ContextMenu="{StaticResource PinMenu}" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="315" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <!-- Imagen fijada con soporte de zoom -->
            <Image x:Name="PinnedImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                </Image.LayoutTransform>
            </Image>

            <!-- Botón flotante para cerrar en esquina superior derecha -->
            <Button x:Name="BtnClose" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="4" Background="#EF4444" Foreground="#FFF" FontWeight="Bold" FontSize="11"
                    BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFF" FontSize="10"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
