<Application x:Class="LightCapture.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- ========================================================================= -->
        <!-- ESTILO UNIVERSAL MODERNO DE MENÚ (Samsung One UI / Windows 11 Dark/Light) -->
        <!-- ========================================================================= -->

        <!-- Template para Items regulares de menú con zoom hover sutil en el icono -->
        <ControlTemplate x:Key="ModernSubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Margin="2,1" Padding="8,6" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" SharedSizeGroup="MenuItemIconColumn"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumn"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="IconHost" Grid.Column="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" 
                               Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="Normal" 
                               VerticalAlignment="Center" Margin="16,0,4,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHover}"/>
                    <Setter TargetName="IconHost" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                    <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Template para Headers de Submenús (con flecha chevron y popup flotante redondeado) -->
        <ControlTemplate x:Key="ModernSubmenuHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Margin="2,1" Padding="8,6" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" SharedSizeGroup="MenuItemIconColumn"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="IconHost" Grid.Column="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Path Grid.Column="2" Data="M0 0 L4 4 L0 8" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" 
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,4,0"/>

                    <Popup x:Name="SubMenuPopup" AllowsTransparency="True" Placement="Right" 
                           VerticalOffset="-4" HorizontalOffset="2"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                           Focusable="False" PopupAnimation="Fade">
                        <Border Background="{DynamicResource MenuBackground}"
                                BorderBrush="{DynamicResource MenuBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHover}"/>
                    <Setter TargetName="IconHost" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                    <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Estilo exclusivo para encabezado no cliqueable de menús (Evita bug de recorte) -->
        <Style x:Key="ModernMenuTitleStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="32"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="Transparent" Padding="8,4,8,6" Margin="0,0,0,4" BorderBrush="{DynamicResource MenuSeparator}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource MenuHover}" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding InputGestureText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo base para MenuItem -->
        <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource ModernSubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource ModernSubmenuHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="HasItems" Value="True">
                    <Setter Property="Template" Value="{StaticResource ModernSubmenuHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo universal para ContextMenu flotante estilo One UI -->
        <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separador de menú moderno -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource MenuSeparator}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{TemplateBinding Background}" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aplica automáticamente el estilo a todos los MenuItem que no tengan estilo explícito -->
        <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItemStyle}"/>
    </Application.Resources>
</Application>
