<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <SupportedOSPlatformVersion>10.0.10240.0</SupportedOSPlatformVersion>
    <AssemblyName>LightCapture</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyTitle>Light Capture Studio</AssemblyTitle>
    <Product>Light Capture Studio</Product>
    <Company>Antigravity</Company>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- En desarrollo local copia los binarios a bin/Debug -->
  <ItemGroup Condition="'$(PublishSingleFile)' != 'true'">
    <Content Include="..\LightCapture.Recorder\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\LightCapture.Recorder.exe;
                     ..\LightCapture.Recorder\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\LightCapture.Recorder.dll;
                     ..\LightCapture.Recorder\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\LightCapture.Recorder.runtimeconfig.json;
                     ..\LightCapture.Recorder\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\ScreenRecorderLib.dll">
      <Link>%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Para Single-File Standalone: Todo se incrusta dentro del .EXE principal -->
  <ItemGroup>
    <EmbeddedResource Include="..\LightCapture.Recorder\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\LightCapture.Recorder.exe" Link="Resources\LightCapture.Recorder.exe" />
    <EmbeddedResource Include="..\LightCapture.Recorder\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\LightCapture.Recorder.dll" Link="Resources\LightCapture.Recorder.dll" />
    <EmbeddedResource Include="..\LightCapture.Recorder\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\LightCapture.Recorder.runtimeconfig.json" Link="Resources\LightCapture.Recorder.runtimeconfig.json" />
    <EmbeddedResource Include="..\LightCapture.Recorder\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\ScreenRecorderLib.dll" Link="Resources\ScreenRecorderLib.dll" />
    <EmbeddedResource Include="app.ico" />
    <Resource Include="Assets\Icons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightCapture.Core\LightCapture.Core.csproj" />
    <ProjectReference Include="..\LightCapture.Recorder\LightCapture.Recorder.csproj" />
  </ItemGroup>

</Project>
